{
	"description": "Declared texture references and what each normalises to. Read by tests/unit/loaders/textureReferences.test.js and tests/unit/Service/ModelDependencyResolverTest.php, so the client and the server's resolver are held to one table. null means the reference is rejected.",
	"cases": [
		{ "ref": "C:\\Users\\anna\\Desktop\\textures\\wood.jpg", "expected": "wood.jpg", "why": "drive letter, backslashes" },
		{ "ref": "C:/textures/wood.jpg", "expected": "wood.jpg", "why": "drive letter, forward slashes" },
		{ "ref": "c:\\wood.jpg", "expected": "wood.jpg", "why": "lower-case drive letter" },
		{ "ref": "D:wood.jpg", "expected": "wood.jpg", "why": "drive-relative" },
		{ "ref": "C:\\Users\\anna\\wood grain.jpg", "expected": "wood grain.jpg", "why": "a space in the name" },
		{ "ref": "  C:\\textures\\wood.jpg  ", "expected": "wood.jpg", "why": "surrounding blanks" },
		{ "ref": "/home/anna/textures/wood.jpg", "expected": "wood.jpg", "why": "leading slash" },
		{ "ref": "/textures/../wood.jpg", "expected": "wood.jpg", "why": "an absolute path is never walked, only its last segment kept" },
		{ "ref": "\\\\server\\share\\textures\\wood.jpg", "expected": "wood.jpg", "why": "UNC" },
		{ "ref": "//server/share/wood.jpg", "expected": "wood.jpg", "why": "UNC with forward slashes" },
		{ "ref": "\\\\?\\C:\\long\\path\\wood.jpg", "expected": "wood.jpg", "why": "Windows extended-length path" },
		{ "ref": "file:///C:/textures/wood.jpg", "expected": "wood.jpg", "why": "file: URL, three slashes" },
		{ "ref": "file://C:/textures/wood.jpg", "expected": "wood.jpg", "why": "file: URL, two slashes" },
		{ "ref": "file:/home/anna/wood.jpg", "expected": "wood.jpg", "why": "file: URL, one slash" },
		{ "ref": "file:wood.jpg", "expected": "wood.jpg", "why": "file: URL, no slash" },
		{ "ref": "file://server/share/wood.jpg", "expected": "wood.jpg", "why": "file: URL with a host" },
		{ "ref": "file:\\\\\\C:\\textures\\wood.jpg", "expected": "wood.jpg", "why": "file: URL written with backslashes" },
		{ "ref": "FILE:///C:/textures/Wood.JPG", "expected": "Wood.JPG", "why": "scheme in upper case; the name keeps its case" },
		{ "ref": "file:///C:/My%20Textures/wood%20grain.jpg", "expected": "wood grain.jpg", "why": "percent-encoded file: URL" },
		{ "ref": "file:///C:/x/b%C3%A4r.png", "expected": "bär.png", "why": "percent-encoded UTF-8" },
		{ "ref": "file:///C:/x/wood.jpg?v=2#top", "expected": "wood.jpg", "why": "query and fragment dropped" },
		{ "ref": "file:///C:/x/100%.png", "expected": "100%.png", "why": "a malformed escape is kept as written" },
		{ "ref": "file:///C:/x/%FF.png", "expected": "%FF.png", "why": "an escape that is not UTF-8 is kept as written" },
		{ "ref": "C:\\textures\\", "expected": null, "why": "no name after the last separator" },
		{ "ref": "C:", "expected": null, "why": "a drive and nothing else" },
		{ "ref": "/", "expected": null, "why": "the root and nothing else" },
		{ "ref": "\\\\server\\share\\", "expected": null, "why": "a share and nothing else" },
		{ "ref": "file:///", "expected": null, "why": "a file: URL with no name" },
		{ "ref": "file:///C:/x/wood.jpg/", "expected": null, "why": "a file: URL ending in a separator" },
		{ "ref": "/home/anna/..", "expected": null, "why": "a name of .." },
		{ "ref": "C:\\textures\\.", "expected": null, "why": "a name of ." },
		{ "ref": "file:///C:/x/%2E%2E", "expected": null, "why": "a name that decodes to .." },
		{ "ref": "file:///C:/x/a%2Fwood.jpg", "expected": null, "why": "a name that decodes to hold a slash" },
		{ "ref": "file:///C:/x/a%5Cwood.jpg", "expected": null, "why": "a name that decodes to hold a backslash" },
		{ "ref": "file:///C:/x/wood%00.jpg", "expected": null, "why": "a name that decodes to hold NUL" },
		{ "ref": "http://example.invalid/wood.jpg", "expected": null, "why": "remote" },
		{ "ref": "https://example.invalid/textures/wood.jpg", "expected": null, "why": "remote" },
		{ "ref": "HTTPS://example.invalid/wood.jpg", "expected": null, "why": "remote, upper-case scheme" },
		{ "ref": "ftp://example.invalid/wood.jpg", "expected": null, "why": "remote" },
		{ "ref": "smb://server/share/wood.jpg", "expected": null, "why": "any other scheme" },
		{ "ref": "data:image/png;base64,AAAA", "expected": null, "why": "embedded" },
		{ "ref": "blob:https://cloud.example.com/0b6c3c4e", "expected": null, "why": "an object URL" },
		{ "ref": "wood.jpg", "expected": "wood.jpg", "why": "relative, unchanged" },
		{ "ref": "textures/wood.jpg", "expected": "textures/wood.jpg", "why": "relative, unchanged" },
		{ "ref": "textures\\wood.jpg", "expected": "textures/wood.jpg", "why": "relative, separators folded" },
		{ "ref": "./textures//wood.jpg", "expected": "textures/wood.jpg", "why": "relative, empty and . segments dropped" },
		{ "ref": "textures/../wood.jpg", "expected": "wood.jpg", "why": "relative, .. collapsed" },
		{ "ref": "a/b/../../wood.jpg", "expected": "wood.jpg", "why": "relative, .. collapsed twice" },
		{ "ref": "wood%20grain.jpg", "expected": "wood%20grain.jpg", "why": "relative, not decoded here: a format that encodes decodes it first" },
		{ "ref": "../wood.jpg", "expected": null, "why": "climbs out of the model's folder" },
		{ "ref": "..\\..\\textures\\wood.jpg", "expected": null, "why": "climbs out, Windows separators" },
		{ "ref": "textures/../../wood.jpg", "expected": null, "why": "climbs out after a segment" },
		{ "ref": "", "expected": null, "why": "empty" },
		{ "ref": "   ", "expected": null, "why": "blank" },
		{ "ref": ".", "expected": null, "why": "the folder itself" }
	]
}
