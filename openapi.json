{
    "openapi": "3.0.3",
    "info": {
        "title": "threedviewer",
        "version": "0.0.1",
        "description": "View, analyze & export 3D models across 20+ formats (mesh, CAD, BIM) with thumbnails, annotations & rendering",
        "license": {
            "name": "agpl"
        }
    },
    "components": {
        "securitySchemes": {
            "basic_auth": {
                "type": "http",
                "scheme": "basic"
            },
            "bearer_auth": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "OCSMeta": {
                "type": "object",
                "required": [
                    "status",
                    "statuscode"
                ],
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "statuscode": {
                        "type": "integer"
                    },
                    "message": {
                        "type": "string"
                    },
                    "totalitems": {
                        "type": "string"
                    },
                    "itemsperpage": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "paths": {
        "/ocs/v2.php/apps/threedviewer/api": {
            "get": {
                "operationId": "api-index",
                "summary": "An example API endpoint.",
                "tags": [
                    "api"
                ],
                "security": [
                    {
                        "bearer_auth": []
                    },
                    {
                        "basic_auth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "OCS-APIRequest",
                        "in": "header",
                        "description": "Required to be true for the API request to pass",
                        "required": true,
                        "schema": {
                            "type": "boolean",
                            "default": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Data returned",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {
                                                    "type": "object",
                                                    "required": [
                                                        "message"
                                                    ],
                                                    "properties": {
                                                        "message": {
                                                            "type": "string"
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Current user is not logged in",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/ocs/v2.php/apps/threedviewer/api/files": {
            "get": {
                "operationId": "api-list-files",
                "summary": "List 3D files.",
                "tags": [
                    "api"
                ],
                "security": [
                    {
                        "bearer_auth": []
                    },
                    {
                        "basic_auth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "OCS-APIRequest",
                        "in": "header",
                        "description": "Required to be true for the API request to pass",
                        "required": true,
                        "schema": {
                            "type": "boolean",
                            "default": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Files returned",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {
                                                    "type": "object",
                                                    "required": [
                                                        "files"
                                                    ],
                                                    "properties": {
                                                        "files": {
                                                            "type": "array",
                                                            "items": {
                                                                "type": "object",
                                                                "required": [
                                                                    "id",
                                                                    "name",
                                                                    "path",
                                                                    "size",
                                                                    "mtime",
                                                                    "mimetype"
                                                                ],
                                                                "properties": {
                                                                    "id": {
                                                                        "type": "integer",
                                                                        "format": "int64"
                                                                    },
                                                                    "name": {
                                                                        "type": "string"
                                                                    },
                                                                    "path": {
                                                                        "type": "string"
                                                                    },
                                                                    "size": {
                                                                        "type": "integer",
                                                                        "format": "int64"
                                                                    },
                                                                    "mtime": {
                                                                        "type": "integer",
                                                                        "format": "int64"
                                                                    },
                                                                    "mimetype": {
                                                                        "type": "string"
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Current user is not logged in",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "ocs"
                                    ],
                                    "properties": {
                                        "ocs": {
                                            "type": "object",
                                            "required": [
                                                "meta",
                                                "data"
                                            ],
                                            "properties": {
                                                "meta": {
                                                    "$ref": "#/components/schemas/OCSMeta"
                                                },
                                                "data": {}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "embed_admin",
            "description": "The admin's list of sites allowed to embed public links. Admins only (no NoAdminRequired), and the request token is checked."
        },
        {
            "name": "embed_page",
            "description": "The page a listed site frames: the same page for every /embed/{token} URL. It reads no share and reveals nothing about one; its script reads the token from the URL and asks PublicEmbedController, which checks the share. Kept apart so that a share that is gone can be said so inside the frame: the share middleware's own \"not found\" page may not be framed, so the visitor would see only the browser's refusal. This is the only response that lists other sites in `frame-ancestors`; every other page keeps Nextcloud's `'self'`."
        },
        {
            "name": "file",
            "description": "Controller for serving 3D files using Nextcloud filesystem API."
        },
        {
            "name": "file_settings",
            "description": "A model's shared settings, for signed-in users: anyone who can open the file reads them, and anyone who can edit it changes them. No route carries NoCSRFRequired."
        },
        {
            "name": "notes",
            "description": "The shared annotations and measurements of a model, for signed-in users. No route carries NoCSRFRequired — the read included, because it runs the legacy migration, and that publishes a user's private annotations to everyone who can open the model."
        },
        {
            "name": "slicer",
            "description": "Controller for handling slicer integration."
        },
        {
            "name": "thumbnail",
            "description": "Stores the thumbnails the browser renders for 3D models, and reports which models have one. A thumbnail is stored once per file version and shown to everyone who can read the file, so this controller is the only gate on who may write one: it requires the CSRF token and update rights on the file, and it only ever stores under the server's own ETag."
        },
        {
            "name": "public_embed",
            "description": "What the embed page shows for a token: the model, and the links around it. MUST extend PublicShareController, for the reason PublicFileController gives: the middleware checks the share, and throttles bad tokens, only for instances of it. A token is valid here only when its share may be embedded (EmbedService), so a share that gained a password, expired, or went is refused before show() runs, and a password-protected share never reaches the password check: a frame has nowhere to ask."
        },
        {
            "name": "public_file",
            "description": "Public (unauthenticated) streaming of shared 3D files via share token. MUST extend PublicShareController rather than plain Controller: PublicShareMiddleware returns early for anything that is not a PublicShareController instance, so a `#[PublicPage]` controller performs no share authorisation at all and will serve password-protected shares to any caller holding the token. Extending it delegates password and token validation to the framework, and brings brute-force throttling with it."
        },
        {
            "name": "public_file_settings",
            "description": "A shared model's settings, read-only, for visitors on a public link. MUST extend PublicShareController, for the reason PublicFileController gives: the middleware enforces share passwords only for instances of it (GHSA-gjh8-x4wm-3cfj). The share lookup is PublicNotesController's."
        },
        {
            "name": "public_notes",
            "description": "A shared model's notes, read-only, for visitors on a public link. MUST extend PublicShareController, for the reason PublicFileController gives: the middleware enforces share passwords only for instances of it (GHSA-gjh8-x4wm-3cfj). Authors are left out so a public link doesn't hand out the names of the people who wrote on the model."
        }
    ]
}
