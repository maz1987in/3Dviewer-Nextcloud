<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
    phpVersion="8.1"
    cacheDirectory=".psalm-cache"
    threads="1"
    errorBaseline="psalm-baseline.xml"
>
    <projectFiles>
        <directory name="lib" />
        <directory name="tests" />
        <!-- Only vendor dirs are listed: psalm aborts with "Could not resolve config
             path" when an ignored directory does not exist, and build/, dist/ and
             node_modules/ are all untracked, so a fresh checkout has none of them.
             That stopped psalm from starting at all on CI. They were redundant anyway —
             projectFiles is lib/ and tests/, so nothing under them was ever in scope. -->
        <ignoreFiles>
            <directory name="vendor" />
            <directory name="vendor-bin" />
        </ignoreFiles>
    </projectFiles>
    <extraFiles>
        <directory name="vendor"/>
    </extraFiles>
    <issueHandlers>
        <UnusedVariable errorLevel="suppress" />
        <UnusedParam errorLevel="suppress" />
        <!-- IConfig's per-user methods are deprecated from Nextcloud 33, but info.xml
             declares min-version 31 and the IUserConfig replacement does not exist
             there. The app cannot migrate while it still supports 31, so a deprecation
             is information rather than a build failure. Revisit when min-version rises;
             the call sites are in PageController, SettingsController and
             ConfigController. -->
        <DeprecatedMethod errorLevel="info" />
    </issueHandlers>
</psalm>
